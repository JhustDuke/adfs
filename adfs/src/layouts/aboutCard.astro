---
import type { AboutSectionCardProps } from "../interfaces";
const {
  id,
  title, 
  textContent, 
  imageSrc, 
  bgColor = "white", 
  textColor = "black-text",
  btnColor = "blue-text" 
} = Astro.props as AboutSectionCardProps
---

<div class="col-12 col-md-4 p-3" id={`card-${id}`}>
  <div class={`card h-100 shadow-sm border-0 ${bgColor}`}>
    
    <div class="position-relative">
      <img src={imageSrc} alt={title} class="card-img-top" style="height: 220px; object-fit: cover;" />
      <div class="position-absolute bottom-0 start-0 p-3 w-100" style="background: linear-gradient(transparent, rgba(0,0,0,0.6));">
        <h5 class="card-title fw-bold text-white mb-0">{title}</h5>
      </div>
    </div>

    <div class="card-body position-relative">
      <div class={`content-wrapper ${textColor}`} style="height: 60px; overflow: hidden;">
        {textContent}
      </div>
      <div class="text-fade"></div>
    </div>

    <div class="card-footer bg-transparent border-0 pt-0 pb-4 px-4">
      <button class={`toggle-btn btn btn-link p-0 fw-bold ${btnColor}`} style="text-decoration: none; border: none; background: none;">
        Read More
      </button>
    </div>

  </div>
</div>

<script is:inline define:vars={{ id }}>
  const container = document.getElementById(`card-${id}`);
  if (container) {
    const btn = container.querySelector(".toggle-btn");
    const wrapper = container.querySelector(".content-wrapper");
    let isExpanded = false;

    btn?.addEventListener("click", function () {
      if (isExpanded) {
        wrapper.style.height = "60px";
        wrapper.style.overflow = "hidden";
        btn.textContent = "Read More";
      } else {
        wrapper.style.height = "auto";
        wrapper.style.overflow = "visible";
        btn.textContent = "Read Less";
      }
      isExpanded = !isExpanded;
    });
  }
</script>

<style>
  .text-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 45px;
    background: linear-gradient(transparent, rgba(255, 255, 255, 0.8));
    pointer-events: none;
  }
</style>