---
import type { AboutSectionCardProps } from "../interfaces";

// "white" and "black-text" are the defaults if you don't pass anything
const { 
  title, 
  textContent, 
  imageSrc, 
  bgColor = "white", 
  textColor = "black-text",
  btnColor = "blue-text" 
} = Astro.props as AboutSectionCardProps

const cardId = `card-${Math.random().toString(36).substring(2, 7)}`;
---

<div class="col-12 col-md-4 p-3" id={cardId}>
  <div class={`card h-100 shadow-sm border-0 ${bgColor}`}>
    
    <div class="position-relative">
      <img src={imageSrc} alt={title} class="card-img-top" style="height: 220px; object-fit: cover;" />
      <div class="position-absolute bottom-0 start-0 p-3 w-100" style="background: linear-gradient(transparent, rgba(0,0,0,0.6));">
        <h5 class="card-title fw-bold text-white mb-0">{title}</h5>
      </div>
    </div>

    <div class="card-body position-relative">
      <div class={`content-wrapper truncate-text ${textColor}`}>
        {textContent}
      </div>
      <div class="text-fade"></div>
    </div>

    <div class="card-footer bg-transparent border-0 pt-0 pb-4 px-4">
      <button class={`toggle-btn btn btn-link p-0 fw-bold ${btnColor}`} style="text-decoration: none; border: none; background: none;">
        Read More
      </button>
    </div>
  </div>
</div>

<style>
  .truncate-text {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  /* Fade effect to white by default */
  .text-fade {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 45px;
    background: linear-gradient(transparent, rgba(255, 255, 255, 0.8));
    pointer-events: none;
  }

  .expanded .truncate-text {
    display: block;
    -webkit-line-clamp: initial;
    overflow: visible;
  }
  
  .expanded .text-fade {
    display: none;
  }
</style>

<script is:inline define:vars={{ cardId }}>
  const container = document.getElementById(cardId);
  const btn = container?.querySelector('.toggle-btn');
  const card = container?.querySelector('.card');

  btn?.addEventListener('click', () => {
    const isExpanded = card.classList.toggle('expanded');
    btn.textContent = isExpanded ? 'Read Less' : 'Read More';
  });
</script>