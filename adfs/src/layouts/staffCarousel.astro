---
import type {staffCarouselInterface} from '../interfaces'


const { AllStaffMembers, id = "staffCarousel" } = Astro.props as staffCarouselInterface
---

<div class="d-flex justify-content-center mt-5 ">
  <div style="max-width:600px; width:100%;">

    <div id={id} class="carousel slide p-2 grey lighten-2 shadow rounded" data-bs-ride="carousel">

      <!-- Indicators -->
      <div class="carousel-indicators">
        {AllStaffMembers.map(function (_, index) {
          return (
            <button
              type="button"
              data-bs-target={`#${id}`}
              data-bs-slide-to={index}
              class={index === 0 ? "active" : ""}
              aria-current={index === 0 ? "true" : "false"}
              aria-label={`Slide ${index + 1}`}
            ></button>
          );
        })}
      </div>

      <!-- Slides -->
      <div class="carousel-inner">
        {AllStaffMembers.map(function (member, index) {
          return (
            <div class={`carousel-item ${index === 0 ? "active" : ""}`}>

              <img
                src={member.imgSrc}
                class="d-block mx-auto rounded-4"
                alt={member.caption}
                style="height:400px; max-width:600px; width:100%; object-fit:contain;"
              />

              <div class="carousel-caption d-md-block bg-dark bg-opacity-50  p-3">
                <h5 class='text-capitalize fw-medium'>{member.caption}</h5>

                {member.subCaption && (
                  <p class="text-capitalize">{member.subCaption}</p>
                )}

              </div>

            </div>
          );
        })}
      </div>

      <!-- Controls -->
      <button
        class="carousel-control-prev black"
        type="button"
        data-bs-target={`#${id}`}
        data-bs-slide="prev"
      >
        <span class="carousel-control-prev-icon"></span>
      </button>

      <button
        class="carousel-control-next black"
        type="button"
        data-bs-target={`#${id}`}
        data-bs-slide="next"
      >
        <span class="carousel-control-next-icon"></span>
      </button>

    </div>

  </div>
</div>