---
import type { subjectCardInterface } from "../interfaces";
const {
  id,
  title,
  description,
  imageSrc,
  captionColor,
  bgColor,
  icon = "bi-book"
} = Astro.props as subjectCardInterface;
---

  
<div id={`card-${id}`} class="col-12 col-md-6 col-lg-3 mb-4">
  <div class={`card h-100 border-0 shadow-sm hover-lift overflow-hidden ${bgColor}`}>

    <a href="/gallery" class="d-block position-relative overflow-hidden">
      <img
        src={imageSrc}
        class="card-img-top object-fit-cover"
        alt={title}
        style="height: 200px;"
      />
    </a>

    <div class="card-body text-center">

      <h3 class={`h5 fw-bold ${captionColor}`}>
        {title}
      </h3>

      <!-- Only the description wrapper is clamped -->
      <div class=`description-wrapper-${id}` style="height: 60px; overflow: hidden;">
        <p class="small text-muted mb-0">
          {description}
        </p>
      </div>

      <button class={`btn btn-sm toggle-btn mt-2 ${captionColor}`}>
        Read More
      </button>

    </div>

  </div>
</div>

<script is:inline define:vars={{ id }}>
  const container = document.getElementById(`card-${id}`);
  if (container) {
    const btn = container.querySelector(".toggle-btn");
    const wrapper = document.querySelector(`.description-wrapper-${id}`);
    let isExpanded = false;

    btn?.addEventListener("click", function () {
      if (isExpanded) {
        wrapper.style.height = "60px";
        wrapper.style.overflow = "hidden";
        btn.textContent = "Read More";
      } else {
        wrapper.style.height = "auto";
        wrapper.style.overflow = "visible";
        btn.textContent = "Read Less";
      }
      isExpanded = !isExpanded;
    });
  }
</script>

<style>
  .hover-lift {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .hover-lift:hover {
    transform: translateY(-8px);
    box-shadow: 0 1rem 2rem rgba(0,0,0,0.1) !important;
  }
  .hover-lift:hover img {
    transform: scale(1.1);
  }
</style>