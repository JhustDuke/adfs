---
import BaseLayout from "../layouts/BaseLayout.astro";
import NewsCard from "../layouts/newsCard.astro";
import {urlStringObj}from './urls'

const newsUrl = new URL(urlStringObj.newsUrl, Astro.request.url);

const res = await fetch(newsUrl);

if (!res.ok) {
	console.log("early return: bad response");
	throw new Error("Request failed");
}

const text = await res.text();

if (!text) {
	console.log("early return: empty body");
	throw new Error("Empty response");
}

let data: any;

try {
	data = JSON.parse(text);
} catch (e) {
	console.log("early return: invalid JSON");
	throw new Error("Invalid JSON response");
}

const news = Array.isArray(data) ? data : [];
const error = data?.error;

if (error) console.error(error);
---

<BaseLayout title="School News & Updates">
  <div class="container my-5">

    <div class="row mb-5 text-center">
      <div class="col-12">
        <h1 class="display-4 fw-bold indigo-text text-darken-4">
          Pupil News & Notices
        </h1>
        <p class="lead grey-text text-darken-2">
          Everything parents and pupils need to know about school life.
        </p>
      </div>
    </div>

    {error && (
      <div class="row">
        <div class="col-12 text-center red-text fw-bolder text-uppercase">
          <p>OOPS, an error occured please try again later!</p>
        </div>
      </div>
    )}

    {!error && news.length === 0 && (
      <div class="row">
        <div class="col-12 text-center text-muted">
          <p>Nothing to display at the moment</p>
        </div>
      </div>
    )}

    {!error && news.length > 0 && (
      <div class="row justify-content-center">
        <div class="col-lg-10">
          {news.map(function (item: any) {
            return (
              <NewsCard
                title={item.title}
                date={item.date}
                excerpt={item.excerpt}
                fullText={item.full_text}
              />
            );
          })}
        </div>
      </div>
    )}

  </div>
</BaseLayout>