---
export const prerender = false
import BaseLayout from "../layouts/BaseLayout.astro";
import SubjectCard from "../layouts/subjectsCard.astro";
import {getAllAcademicCardsModel} from '../model'
import type {AllAcademicDataInterface} from '../model'



let academicData:AllAcademicDataInterface[]=[]


let error: string | null = null;

try {
	academicData = await getAllAcademicCardsModel()

		} 
		catch (err:any) {
	console.log("academic: fetch error",err);
	error = err.message || 'failed to fetch data'
}

---

<BaseLayout title="Academics | Our Curriculum">
	<div class="container my-5">

		<!-- HEADER -->
		<div class="row mb-5 text-center">
			<div class="col-12">
				<h1 class="display-4 fw-bold indigo-text text-darken-4">
					Our Academic Pillars
				</h1>
			</div>
		</div>

		<!-- ERROR STATE -->
		{error && (
			<div class="text-center text-muted red-text">
				
				{error}
			</div>
		)}

		<!-- EMPTY STATE -->
		{!error && academicData.length === 0 && (
			<div class="text-center text-muted green-text">
				
				No data to display at the moment
			</div>
		)}

		<!-- DATA -->
		{!error && academicData.length > 0 && (
			<div class="row">
				{academicData.map(function (item) {
					return (
						<SubjectCard
							id={item.id}
							title={item.title}
							imageSrc={item.imageSrc}
							description={item.textContent}
							captionColor={item.textCaptionColor}
							bgColor={item.bgColor}
						/>
					);
				})}
			</div>
		)}

	</div>
</BaseLayout>