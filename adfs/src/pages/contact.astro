---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contact Us">

  <div class="text-center my-4">
    <h1 class="fw-bold">Contact Us</h1>
    <p>
      Reach out to Amen Divine Foundation School, Owerri for inquiries,
      admissions, or general questions.
    </p>
  </div>

  <!-- ===================================================== -->
  <!-- CONTACT INFO + MAP                                    -->
  <!-- ===================================================== -->

  <div class="container">
    <div class="row justify-content-center mt-4">

      <div class="col-md-8">
        <div class="card grey lighten-4 p-4">

          <!-- School Information -->
          <h5 class="text-primary fw-bold mb-3">
            School Information
          </h5>

          <p class="text-primary mb-4">
            <strong>Address:</strong> 123 Main Street, Owerri, Imo State<br />
            <strong>Phone:</strong> 
            <a href="tel:+2341234567890" class="text-decoration-none text-primary">
              +234 123 456 7890
            </a><br />

            <strong>Email:</strong> 
            <a href="mailto:info@adfsowerri.edu.ng" class="text-decoration-none text-primary">
              info@adfsowerri.edu.ng
            </a><br />

            <strong>Office Hours:</strong> Mon - Fri, 8:00am - 4:00pm
          </p>

          <!-- Map Helper Text -->
          <p class="text-muted small">
            If the map does not display, please use the "Get Directions" button below.
          </p>

          <!-- Google Map -->
          <div class="mt-2">

            <iframe
              src="https://www.google.com/maps?q=Amen+Divine+Foundation+School,+Owerri&output=embed"
              width="100%"
              height="350"
              style="border:0"
              loading="lazy"
              title="Google Map showing Amen Divine Foundation School location in Owerri">

            	

            </iframe>  <!-- Fallback Content -->
									

          </div>

          <!-- Directions Button -->
          <div class="mt-3">
            <a
              href="https://www.google.com/maps/search/?api=1&query=Amen+Divine+Foundation+School,+Owerri"
              target="_blank"
              class="btn btn-primary w-100">
              Get Directions
            </a>
          </div>

        </div>
      </div>

    </div>
  </div>

</BaseLayout>