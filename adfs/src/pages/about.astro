---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../layouts/aboutCard.astro";
import StaffsCarousel from "../layouts/staffCarousel.astro";
import { urlStringObj } from "./urls";

/* ABOUT */
let aboutCards: any[] = [];
let staffMembers: any[] = [];
let error: string | null = null;

try {
  const aboutRes = await fetch(new URL(urlStringObj.aboutUrl, Astro.request.url));

  if (aboutRes.ok) {
    const body = await aboutRes.json();
    aboutCards = Array.isArray(body?.data) ? body.data : [];
  }

  const staffRes = await fetch(new URL(urlStringObj.staffUrl, Astro.request.url));

  if (staffRes.ok) {
    const staffBody = await staffRes.json();
    staffMembers = Array.isArray(staffBody) ? staffBody : [];
  }

} catch (e) {
  error = "fetch failed";
}
---

<BaseLayout title="About Our School">

  <div class="container my-5">

    <!-- HEADER -->
    <div class="text-center mb-5">
      <h1 class="display-4 fw-bold indigo-text text-darken-4">
        Nurturing Young Minds
      </h1>
    </div>

    <!-- ABOUT EMPTY -->
    {!error && aboutCards.length === 0 && (
      <div class="text-center text-muted">
        <!-- fallback: about empty -->
        No data to display at the moment
      </div>
    )}

    <!-- ABOUT CARDS -->
    {!error && aboutCards.length > 0 && (
      <div class="row">
        {aboutCards.map(function (card) {
          return (
            <Card
              id={card.id}
              title={card.title}
              textContent={card.textContent}
              imageSrc={card.imageSrc}
            />
          );
        })}
      </div>
    )}

    <!-- STAFF EMPTY -->
    {!error && staffMembers.length === 0 && (
      <div class="text-center text-muted mt-5">
        <!-- fallback: staff empty -->
        No staff data available
      </div>
    )}

    <!-- STAFF -->
    {!error && staffMembers.length > 0 && (
      <div class="row mt-5 pt-4">
        <div class="col-12">
          <StaffsCarousel AllStaffMembers={staffMembers} />
        </div>
      </div>
    )}

  </div>

</BaseLayout>