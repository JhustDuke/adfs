---
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../layouts/aboutCard.astro";
import StaffsCarousel from "../layouts/staffCarousel.astro";
import { urlStringObj } from "./urls";

/* ================= ABOUT API ================= */
const aboutUrl: URL = new URL(
  urlStringObj.aboutUrl,
  Astro.request.url
);

const aboutRes: Response = await fetch(aboutUrl);

if (!aboutRes.ok) {
  const error: { message?: string } = await aboutRes.json();
  throw new Error(error.message || "failed to get about page");
}

const aboutResponseBody: {
  message: string;
  data: Array<{
    id: number;
    title: string;
    textContent: string;
    imageSrc: string;
  }>;
} = await aboutRes.json();



if (!aboutResponseBody?.data?.length) {
  throw new Error("about response is empty");
}

const aboutCards = aboutResponseBody.data.map(function (item) {
  return {
    id: item.id,
    title: item.title,
    textContent: item.textContent,
    imageSrc: item.imageSrc
  };
});

/* ================= STAFF API ================= */
const staffUrl: URL = new URL(
  urlStringObj.staffUrl,
  Astro.request.url
);

const staffRes: Response = await fetch(staffUrl);

if (!staffRes.ok) {
  const error: { message?: string } = await staffRes.json();
  throw new Error(error.message || "failed to get staff data");
}

const staffResponseBody = await staffRes.json();



if (!Array.isArray(staffResponseBody) || !staffResponseBody.length) {
  throw new Error("staff response is empty");
}

const staffMembers = staffResponseBody.map(function (staff: any) {
  return {
    id: staff.id,
    imgSrc: staff.imageUrl,
    caption: staff.name,
    subCaption: staff.role
  };
});
---

<BaseLayout title="About Our School">

  <div class="container my-5">

    <!-- ================= HEADER ================= -->
    <div class="row mb-5">
      <div class="col-12 text-center">
        <h1 class="display-4 fw-bold indigo-text text-darken-4">
          Nurturing Young Minds
        </h1>

        <p class="lead grey-text text-darken-2">
          Providing a foundation of excellence for every pupil in our care.
        </p>
      </div>
    </div>

    <!-- ================= ABOUT CARDS ================= -->
    <div class="row">
      {
        aboutCards.map(function (card) {
          return (
            <Card
              id={card.id}
              title={card.title}
              textContent={card.textContent}
              imageSrc={card.imageSrc}
            />
          );
        })
      }
    </div>

    <!-- ================= STAFF SECTION ================= -->
    <div class="row mt-5 pt-4">

      <div class="col-12 text-center mb-4">
        <h2 class="fw-bold indigo-text text-darken-4">
          Meet Our Dedicated Staff
        </h2>

        <hr
          class="mx-auto"
          style="width: 50px; height: 3px; background: #1a237e;"
        />
      </div>

      <div class="col-12">
        <StaffsCarousel AllStaffMembers={staffMembers} />
      </div>

    </div>

  </div>

</BaseLayout>