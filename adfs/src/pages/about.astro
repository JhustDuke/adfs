---
export const prerender = false
import BaseLayout from "../layouts/BaseLayout.astro";
import Card from "../layouts/aboutCard.astro";
import StaffsCarousel from "../layouts/staffCarousel.astro";

import {getAllAboutCardsModel,getAllStaffsModel} from '../model'


/* ABOUT */

let aboutCards:{id:number,title:string,imageSrc:string,textContent:string}[]=[]

let staffMembers: {id:number,caption:string,imgSrc:string,subCaption:string}[] = [];
let error: string | null = null;

try {

  aboutCards = (await getAllAboutCardsModel()).map( function(card:any){
    return{
      id: card.id,
    title: card.title || "",
    imageSrc: card.imageSrc || "",
    textContent: card.textContent || ""
    }
  });
 
  staffMembers=(await getAllStaffsModel()).map(function(item:any){
    return {
      id:item.id,
      caption:item.name,
      imgSrc:item.imageUrl,
      subCaption:item.role
    }
  })


 

} catch (err:any) {
  console.log(err)
  error = err.message || 'something went wrong'
}
---

<BaseLayout title="About Our School">

  <div class="container my-5">

    <!-- HEADER -->
    <div class="text-center mb-5">
      <h1 class="display-4 fw-bold indigo-text text-darken-4">
        Nurturing Young Minds
      </h1>
    </div>


    <!-- error -->
    {error  && (
      <div class="text-center text-muted red-text">
        {error}
      </div>
    )}
    <!-- ABOUT EMPTY -->
    {!error && aboutCards.length === 0 && (
      <div class="text-center text-muted green-text">
        <!-- fallback: about empty -->
        No data to display at the moment
      </div>
    )}
    

    <!-- ABOUT CARDS -->
    {!error && aboutCards.length > 0 && (
      <div class="row">
        {aboutCards.map(function (card) {
          return (
            <Card
              id={card.id}
              title={card.title}
              textContent={card.textContent}
              imageSrc={card.imageSrc}
            />
          );
        })}
      </div>
    )}


<!-- staffs -->



<!-- staff error -->
{error &&  (
  <div class="text-center text-muted mt-5 red-text">
    something went wrong
  </div>
)}
    <!-- STAFF EMPTY -->
    {!error && staffMembers.length === 0 && (
      <div class="text-center text-muted mt-5 green-text">
        <!-- fallback: staff empty -->
        No staff data available
      </div>
    )}
    

    <!-- STAFF -->
    {!error && staffMembers.length > 0 && (
      <h5 class='text-uppercase fw-bold blue-text text-darken-4 mt-5'>meet our dedicated team</h3>
      <div class="row mt-2 pt-4">
        <div class="col-12">
          <StaffsCarousel AllStaffMembers={staffMembers} />
        </div>
      </div>
    )}

  </div>

</BaseLayout>