---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCard from "../layouts/galleryCard.astro";
import { urlStringObj } from "./urls";

const galleryUrl = new URL(urlStringObj.galleryUrl, Astro.request.url);

let galleryItems: any[] = [];
let error: string | null = null;

try {
	const res = await fetch(galleryUrl);

	if (!res.ok) {
		console.log("gallery: bad response");
		error = "request failed";
	} else {
		const text = await res.text();

		if (!text) {
			console.log("gallery: empty body");
			error = "empty response";
		} else {
			try {
				const body = JSON.parse(text);

				const data = body?.data;

				if (Array.isArray(data) && data.length > 0) {
					galleryItems = data;
				} else {
					galleryItems = [];
				}

				if (body?.error) {
					error = body.error;
				}
			} catch (e) {
				console.log("gallery: invalid json");
				error = "invalid json";
			}
		}
	}
} catch (e) {
	console.log("gallery: fetch failed");
	error = "fetch failed";
}
---

<BaseLayout title="School Gallery">
	<div class="container my-5">

		<div class="text-center mb-5">
			<h1 class="display-4 fw-bold indigo-text text-darken-4">
				Memories & Milestones
			</h1>
		</div>

		<!-- fallback: error state -->
		{error && (
			<div class="text-center text-muted">
				<!-- fallback: server / fetch issue -->
				No data to display at the moment
			</div>
		)}

		<!-- fallback: empty state -->
		{!error && galleryItems.length === 0 && (
			<div class="text-center text-muted">
				<!-- fallback: valid response but no data -->
				No data to display at the moment
			</div>
		)}

		<!-- data -->
		{!error && galleryItems.length > 0 && (
			<div class="row g-4">
				{galleryItems.map(function (folder: any) {
					return (
						<GalleryCard
							id={folder.galleryDB_id}
							caption={folder.caption}
							date={folder.date}
							images={folder.images}
						/>
					);
				})}
			</div>
		)}

		<!-- back button always visible -->
		<div class="row mt-5 pt-4 border-top">
			<div class="col-12 text-center">
				<a href="/academics" class="btn btn-outline-primary rounded-pill px-4">
					Back
				</a>
			</div>
		</div>

	</div>
</BaseLayout>