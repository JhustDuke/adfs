---
export const prerender = false
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCard from "../layouts/galleryCard.astro";
import {getAllGalleryModel} from '../model'
import type{AllGalleryData} from '../model'



let galleryData:AllGalleryData[]=[]
let error: string | null = null;

try {
galleryData=await getAllGalleryModel()
	
			} catch (err:any) {
				
				error = err.message || 'failed to get gallery data';
			}
			 
---

<BaseLayout title="School Gallery">
	<div class="container my-5">

		<div class="text-center mb-5">
			<h1 class="display-4 fw-bold indigo-text text-darken-4">
				Memories & Milestones
			</h1>
		</div>

		<!-- fallback: error state -->
		{error && (
			<div class="text-center text-muted red-text">
				{error}
			</div>
		)}

		<!-- fallback: empty state -->
		{!error && galleryData.length === 0 && (
			<div class="text-center text-muted green-text">
				
				No data to display at the moment
			</div>
		)}

		<!-- data -->
		{!error && galleryData.length > 0 && (
			<div class="row g-4">
				{galleryData.map(function (folder: any) {
					return (
						<GalleryCard
							id={folder.galleryDB_id}
							caption={folder.caption}
							date={folder.date}
							images={folder.images}
						/>
					);
				})}
			</div>
		)}

		<!-- back button always visible -->
		<div class="row mt-5 pt-4 border-top">
			<div class="col-12 text-center">
				<a href="/academics" class="btn btn-outline-primary rounded-pill px-4">
					Back
				</a>
			</div>
		</div>

	</div>
</BaseLayout>