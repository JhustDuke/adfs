---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCard from "../layouts/galleryCard.astro";
import { urlStringObj } from "./urls";

const galleryUrl: URL = new URL(urlStringObj.galleryUrl, Astro.request.url);
const galleryRes: Response = await fetch(galleryUrl);

if (!galleryRes.ok) {
  const error: { message?: string } = await galleryRes.json();
  throw new Error(error.message || "failed to fetch gallery data");
}

const galleryResponseBody = await galleryRes.json();

if (!galleryResponseBody?.data?.length) {
  throw new Error("gallery response is empty");
}

const galleryItems = galleryResponseBody.data;
---

<BaseLayout title="School Gallery">
  <div class="container my-5">

    <div class="text-center mb-5">
      <h1 class="display-4 fw-bold indigo-text text-darken-4">
        Memories & Milestones
      </h1>
      <p class="lead grey-text text-darken-2">
        A glimpse into daily life at our school.
      </p>
    </div>

    <div class="row g-4">
      {
        galleryItems.map(function (folder: any) {
          return (
            <GalleryCard
              id={folder.galleryDB_id}
              caption={folder.caption}
              date={folder.date}
              images={folder.images}
            />
          );
        })
      }
    </div>

    <div class="row mt-5 pt-4 border-top">
      <div class="col-12 text-center">
        <a href="/academics" class="btn btn-outline-primary rounded-pill px-4">
          <i class="bi bi-arrow-left me-2"></i> Back to Academics
        </a>
      </div>
    </div>

  </div>
</BaseLayout>