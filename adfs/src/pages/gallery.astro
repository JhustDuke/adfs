---
import BaseLayout from "../layouts/BaseLayout.astro";
import GalleryCard from "../layouts/galleryCard.astro";

// Updated data: Images are now objects with captions
const sciencePhotos = [
  { src: "https://images.unsplash.com/photo-1530210124550-912dc1381cb8?w=800", caption: "Year 5 Chemical Reaction Lab" },
  { src: "https://images.unsplash.com/photo-1562774053-701939374585?w=800", caption: "Studying Plant Biology" }
];

const artsPhotos = [
  { src: "https://images.unsplash.com/photo-1513364776144-60967b0f800f?w=800", caption: "Finger Painting Workshop" },
  { src: "https://images.unsplash.com/photo-1547826039-bfc35e0f1ea8?w=800", caption: "Primary 2 Clay Sculpting" }
];

const ictPhotos = [
  { src: "https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=800", caption: "Introduction to Scratch Coding" },
  { src: "https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=800", caption: "Digital Literacy Class" }
];

const extraPhotos = [
  { src: "https://images.unsplash.com/photo-1511632765486-a01980e01a18?w=800", caption: "Inter-House Football Finals" },
  { src: "https://images.unsplash.com/photo-1461896756913-c8b40e72c81a?w=800", caption: "Annual Track and Field Meet" }
];
---

<BaseLayout title="School Gallery">
  <div class="container my-5">
    <div class="text-center mb-5">
      <h1 class="display-4 fw-bold indigo-text text-darken-4">Memories & Milestones</h1>
      <p class="lead grey-text text-darken-2">A glimpse into daily life at our school.</p>
    </div>

    <div class="row g-4">
      <GalleryCard 
        folderId="science-gallery" 
        title="Science Lab Highlights" 
        date="March 2026" 
        images={sciencePhotos} 
      />

      <GalleryCard 
        folderId="arts-gallery" 
        title="Creative Arts Exhibition" 
        date="February 2026" 
        images={artsPhotos} 
      />

      <GalleryCard 
        folderId="ict-gallery" 
        title="ICT & Robotics Center" 
        date="January 2026" 
        images={ictPhotos} 
      />

      <GalleryCard 
        folderId="sports-gallery" 
        title="Sports & Extracurricular" 
        date="December 2025" 
        images={extraPhotos} 
      />
    </div>

    <div class="row mt-5 pt-4 border-top">
      <div class="col-12 text-center">
        <a href="/academics" class="btn btn-outline-primary rounded-pill px-4">
          <i class="bi bi-arrow-left me-2"></i> Back to Academics
        </a>
      </div>
    </div>
  </div>
</BaseLayout>